<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Forward /api calls to the Express Node.js backend running on 127.0.0.1:4000
  <IfModule mod_proxy.c>
    RewriteRule ^api/(.*)$ http://127.0.0.1:4000/api/$1 [P,L]
  </IfModule>

  # 2. Do not rewrite real files or directories
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # 3. For any other route (except /api), route to index.html for React SPA
  RewriteCond %{REQUEST_URI} !^/api
  RewriteRule . /index.html [L]
</IfModule>
