# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# production
/dist
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
server.log
public/build-render.log
jar.txt

# Raw hero footage is huge (GBs) and regenerable from the manifest + Pexels.
# Only the rendered output (public/hero/*.mp4) is committed.
/public/hero-footage/raw/

# Transient image candidates used while sourcing stock imagery.
docs/tmp-paris-cand-*.jpg

# env files (protect all environment files except .env.example)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/

# Oversized source brochure PDF (>100MB — exceeds GitHub's file-size limit).
# Kept locally in packages/ but not committed. Store it in cloud storage instead.
packages/*Brochure*.pdf

# Python cache
__pycache__/
*.pyc
