# ==============================================================================
# Yana Travels — Environment Configuration Template (.env.example)
# Copy this file to .env and configure the values for your environment.
# Never commit real passwords, secrets, or production credentials to git.
# ==============================================================================

# Node Environment & Server Port
NODE_ENV=production
PORT=4000

# PostgreSQL Database Connection URL (authoritative)
# Format: postgres://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://your_db_user:your_db_password@127.0.0.1:5432/your_db_name

# Database SSL configuration (disable for local / non-SSL PostgreSQL instances)
DB_SSL=disable
DB_POOL_MAX=10

# Admin Authentication
ADMIN_EMAIL=admin@yanatravels.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Secret for HMAC signing session tokens (must be at least 32 random characters)
AUTH_SECRET=generate_a_random_32_character_string_for_production_sessions

# Allowed CORS Origins (comma-separated domains)
ALLOWED_ORIGINS=https://yanat.roiclients.co.in,https://yanaindia.com,https://www.yanaindia.com
